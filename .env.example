# Temper AI — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM Providers ──────────────────────────────────────────
# Configure at least one provider. Uncomment and set values.

# === Quickest start: OpenAI (most developers have this) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# === Free / local: Ollama (no API key needed) ===
# Install: brew install ollama && ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# === Anthropic ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === vLLM (self-hosted) ===
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=qwen3-next

# === Gemini ===
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── Jev (TypeSafe AI) ─────────────────────────────────────
# Not an LLM provider: the key for `type: jev` agents, which ask Jev typed
# questions (noul / choice / score). Key from https://typesafe.ai.
# TYPESAFE_API_KEY=...
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# ── Database ──────────────────────────────────────────────
# Default: PostgreSQL via docker compose (no change needed)
# For local dev without Docker: use SQLite (auto-created)
# TEMPER_DATABASE_URL=sqlite:///data/dev.db
# TEMPER_DATABASE_URL=postgresql://temper_ai:temper_dev@localhost:5433/temper_ai

# ── Docker Paths ──────────────────────────────────────────
# Workspace directory mounted into the container
# WORKSPACE_DIR=./workspaces

# Claude Code CLI (optional — only needed for claude provider)
# Generate token: claude setup-token (requires Claude Pro/Max subscription)
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# CLAUDE_CODE_MODEL=opus

# ── Memory ────────────────────────────────────────────────
# sql (default)  — persists in the same database as runs and events
# mem0           — semantic recall, needs mem0ai installed
# in_memory      — per-process dict; lost on exit, and a workflow run by a
#                  worker keeps its own copy, so agents recall nothing
# TEMPER_MEMORY_BACKEND=sql

# ── Logging ───────────────────────────────────────────────
# TEMPER_LOG_LEVEL=INFO

# Which provider workflows use when they do not name one. Shipped
# workflows deliberately do not pin a provider, so they run on whatever
# you configured above. Set this only to choose between several.
# TEMPER_DEFAULT_PROVIDER=claude

# Require a bearer token on the API, the MCP endpoint and the WebSocket.
# Unset = open to anyone who can reach the server. The dashboard prompts
# for it once and keeps it in the browser.
#   TEMPER_API_TOKEN=$(openssl rand -hex 32)
# TEMPER_API_TOKEN=

# --- Exposure -----------------------------------------------------------
# Published ports bind to loopback by default: the dashboard and the MCP
# endpoint have no authentication. Put a gateway in front of the server
# rather than opening this up.
# TEMPER_BIND=0.0.0.0
#
# Hostnames the MCP endpoint is served under. The MCP SDK rejects any other
# Host header (DNS-rebinding protection) with a 421, so a server behind a
# gateway must name itself here.
# TEMPER_MCP_ALLOWED_HOSTS=temper.example.com,host.tailnet.ts.net
