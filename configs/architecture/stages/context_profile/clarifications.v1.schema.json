{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "temper:architecture/stages/context_profile/clarifications.v1.schema.json",
  "title": "Context profile clarification history v1",
  "description": "Additive caller-attributed history, not a context_profile/v2 replacement or authority receipt. All objects are closed. context_profile_clarifications.validate_record also checks content-bound question IDs, actor/source correspondence, unique IDs and ordered supersession references; JSON Schema alone cannot check those relations. No source reference is dereferenced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "brief_sha256", "questions", "events"],
  "properties": {
    "contract": {"const": "context_profile_clarifications/v1"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "events": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/answer_event"}, {"$ref": "#/$defs/reopen_event"}]}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "question_id": {"type": "string", "pattern": "^q-[0-9a-f]{64}(?![\\s\\S])"},
    "event_id": {"type": "string", "pattern": "^e-[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"},
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s\\x00-\\x20\\x7f]+(?![\\s\\S])",
      "description": "Opaque caller reference with a scheme and nonempty whitespace/control-free suffix. Syntax only: not a URL fetch, proof of identity, permission or consent."
    },
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "field": {
      "enum": ["maturity.stage", "current_system.state", "current_system.items", "external_systems", "workload.observed", "workload.projected", "workload.peaks", "performance.targets", "reliability.availability", "reliability.data_loss_tolerance", "reliability.recovery_time", "privacy.data_categories", "privacy.sensitivity", "privacy.retention", "privacy.sharing", "privacy.jurisdictions_or_rules", "security.requirements", "security.threats", "security.compliance", "team.size", "team.skills", "team.operating_capacity", "budget.build", "budget.run_monthly", "constraints", "goals"]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "why_it_matters", "decisions_affected", "material"],
      "properties": {
        "question_id": {"$ref": "#/$defs/question_id"},
        "question": {"type": "string", "minLength": 5, "pattern": "\\S"},
        "why_it_matters": {"type": "string", "minLength": 5, "pattern": "\\S"},
        "decisions_affected": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "pattern": "\\S"}},
        "material": {"type": "boolean"},
        "field": {"$ref": "#/$defs/field"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["human", "model"]},
        "ref": {"$ref": "#/$defs/reference"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["human_response", "model_output"]},
        "ref": {"$ref": "#/$defs/reference"}
      }
    },
    "answer_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "question_id", "kind", "actor", "source", "answer", "disposition", "supersedes"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "question_id": {"$ref": "#/$defs/question_id"},
        "kind": {"const": "answer"},
        "actor": {"$ref": "#/$defs/actor"},
        "source": {"$ref": "#/$defs/source"},
        "answer": {"$ref": "#/$defs/text"},
        "disposition": {"enum": ["answered", "deferred", "unknown"]},
        "supersedes": {"type": "array", "items": {"$ref": "#/$defs/event_id"}},
        "reason": {"$ref": "#/$defs/text"}
      }
    },
    "reopen_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "question_id", "kind", "actor", "source", "reason"],
      "properties": {
        "event_id": {"$ref": "#/$defs/event_id"},
        "question_id": {"$ref": "#/$defs/question_id"},
        "kind": {"const": "reopen"},
        "actor": {"$ref": "#/$defs/actor"},
        "source": {"$ref": "#/$defs/source"},
        "reason": {"$ref": "#/$defs/text"}
      }
    }
  }
}
