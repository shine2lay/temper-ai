{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-t1-projection/v1",
  "title": "T1 D1 exact-byte projection metadata (not judging admission)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inputs", "inventory", "prompt_sha256", "prompt_bytes"],
  "properties": {
    "schema": {"const": "context-t1-projection/v1"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet", "label_rules", "format"],
      "properties": {
        "packet": {"$ref": "#/$defs/input"},
        "label_rules": {"$ref": "#/$defs/input"},
        "format": {"$ref": "#/$defs/input"}
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Exact packet order. IDs must also be unique independently of paths; checked by D1/D2.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "path": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2000000}
      }
    }
  }
}
