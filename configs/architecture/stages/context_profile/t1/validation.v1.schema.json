{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-t1-validation/v1",
  "title": "T1 D2 strict raw-answer validation (format only, no repair)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slot", "raw_sha256", "raw_bytes", "packet_sha256", "verdict", "reject_reasons"],
  "properties": {
    "schema": {"const": "context-t1-validation/v1"},
    "slot": {"enum": ["A1", "A2", "A3", "B1", "B2", "B3"]},
    "raw_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "raw_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 2000000},
    "packet_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "verdict": {"enum": ["PASS", "REJECT"]},
    "reject_reasons": {
      "type": "array",
      "uniqueItems": true,
      "description": "First deterministic failure only. Never rejected content or repair instructions.",
      "items": {"$ref": "#/$defs/reason"}
    },
    "decision_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "description": "PASS only; exact packet order, independently of answer order.",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}},
      "then": {
        "required": ["decision_ids"],
        "properties": {
          "raw_sha256": {"$ref": "#/$defs/sha256"},
          "raw_bytes": {"type": "integer", "minimum": 1},
          "packet_sha256": {"$ref": "#/$defs/sha256"},
          "reject_reasons": {"maxItems": 0}
        }
      },
      "else": {
        "not": {"required": ["decision_ids"]},
        "properties": {"reject_reasons": {"minItems": 1, "maxItems": 1}}
      }
    },
    {
      "if": {"properties": {"raw_sha256": {"type": "null"}}},
      "then": {"properties": {"raw_bytes": {"type": "null"}}},
      "else": {"properties": {"raw_bytes": {"type": "integer"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason": {
      "enum": [
        "invalid_utf8", "bom", "code_fence", "prose", "trailing_data", "malformed_json",
        "duplicate_json_key", "nan", "infinity", "overflow_nonfinite", "invalid_unicode",
        "field_extra", "field_missing", "field_type", "schema", "invalid_id", "duplicate_id",
        "missing_id", "extra_id", "target_path", "label", "family", "nonbad_family",
        "empty_span", "nonliteral_span", "sentinel_label", "empty_rationale", "rationale_too_long",
        "path", "symlink", "file_type", "hardlink", "file_mode", "size", "directory_mode",
        "filesystem", "file_changed", "input_alias", "leak_marker", "packet_schema",
        "packet_control", "pointer", "projection_schema", "projection_digest", "projection_bytes",
        "projection_inventory", "projection_packet_pin"
      ]
    }
  }
}
