 "identity_format": "case@WIDTHxHEIGHT; case-major order; harness only",
 "normalize": {
  "comments": "every HTML comment removed (the reader refuses comments)",
  "img-hr": "every img and hr element removed (void elements outside the reader's tag set)",
  "svg-line": "every svg line and polyline removed (outside the reader's svg set g, path, circle, rect, polygon)",
  "blockquote": "blockquote renamed figure, attributes and text kept (outside the reader's tag set)",
  "cite": "cite renamed figcaption, text kept (outside the reader's tag set)",
  "entity": "the entity &amp; written as the word and (the reader refuses entities)",
  "inline-style": "every inline style attribute removed (margin is outside the reader's inline properties)"
 },
 "body_mark_rule": "Running text = every p element whose start tag has no attributes (<p>); each gets data-typography=\"Body\", the homepage build stage's own type-role mark. Styled paragraphs (a class or another data-typography role: lede, kicker, fine print, prices) are not body copy and stay unmarked.",
 "identity_rule": "Body-copy declarations are the elements whose data-typography attribute is exactly \"Body\", in document order. Identity = the element's id attribute when it has one; otherwise its document-order path: \"body\", then for each element from body's child down to the element, \">\" + tag name + \"[\" + n + \"]\", where n is the element's 1-based position among its parent's element children with the same tag name, counted in source order (void elements and self-closed svg children count). The inventory for a page = all its Body-marked identities, in document order. Same rule as H16's real-page key.",
 "plants": {
  "P0": "the normalized, Body-marked page as is",
  "P1": "a second visible h1, <h1>Planted second heading</h1>, inserted just before the page's last </section> (after the original h1)",
  "P2": "the page's one h1 demoted to h2: its <h1 and </h1> renamed <h2 and </h2>, attributes and content unchanged",
  "P3": "a second h1 inside an element with the hidden attribute, <div hidden><h1>Planted hidden heading</h1></div>, inserted just before the page's last </section>",
  "P4": "the headline lengthened to 15 words (the A1-02 limit + 3) by inserting plain words from [\"and\", \"these\", \"extra\", \"planted\", \"words\", \"push\", \"the\", \"headline\", \"well\", \"past\", \"twelve\"] just before </h1>",
  "P5": "the first word of the h1's first text run replaced by \"Planted\" (one word changed, count unchanged)"
 },
