# Validation Engine rails: the one-time owner setup for LIVE (paid) tests (docs/validation_engine.md).
#
# Copy to ~/.config/validation-engine/rails.env, fill it in, then `chmod 600` it. Never commit the
# filled-in copy. The engine reads key NAMES to decide what may run and never prints a value; the
# live steps read the values from the file at the moment they call a service.
#
# Without this file (or with any group empty) every run is a dry run: a local test URL, a simulated
# crowd, zero spend. A run asked for mode=live stops before deploying anything and shows what is missing.

# --- brand + domain: a neutral test brand, never the owner's main brand -----------------------------
VE_BRAND=
VE_DOMAIN=

# --- host: Netlify (static page + Netlify Forms for signups, follow-up answers, call requests) -------
NETLIFY_AUTH_TOKEN=
# Optional: an existing site to deploy to (otherwise one is created on VE_DOMAIN).
NETLIFY_SITE_ID=

# --- analytics: PostHog (raw events; the engine applies its own bot filter) -------------------------
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# --- ads: the channels to run, each with billing attached and API access -----------------------------
VE_AD_CHANNELS=google-search,reddit-ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REFRESH_TOKEN=
REDDIT_ADS_ACCOUNT_ID=
# Only when VE_AD_CHANNELS lists meta-ads:
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
META_ADS_PAGE_ID=

# --- Stripe: refundable deposits via Payment Links (sk_test_... runs a rehearsal with test cards) ---
STRIPE_SECRET_KEY=

# --- budgets per idea, and the standing go-ahead to spend within them -------------------------------
# The owner sets each one; nothing is spent while it is empty. The spec suggests ~50 (screen) and
# 200-400 (confirm, survivors only).
VE_SCREEN_BUDGET_USD=
VE_CONFIRM_BUDGET_USD=
VE_TARGET_COUNTRIES=US
# yes = the owner's standing go-ahead; the engine still stops before exceeding a budget above.
VE_GO_AHEAD=
VE_GO_AHEAD_BY=
VE_GO_AHEAD_DATE=

# --- Rung 4 (optional): opt-in panel + disclosed AI voice interviews ---------------------------------
VE_PANEL=
VE_PANEL_API_KEY=
VE_VOICE=
VE_VOICE_API_KEY=
VE_INTERVIEW_BUDGET_USD=
