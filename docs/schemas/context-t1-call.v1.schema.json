{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/temper/schemas/context-t1-call.v1.schema.json",
  "title": "Content-free single-call transport and accounting receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slot", "run_id", "session_id", "workflow_run_id", "provider", "model", "route", "auth_mode", "pricing_sha256", "output_bound_mode", "raw_path", "raw_bytes", "raw_sha256", "output_bound_tokens", "output_bound_evidence_sha256", "serialized_body_sha256", "serialized_body_bytes", "input_parts", "parameters", "usage", "stop_reason", "response_id", "error_class", "http_status", "http_started_monotonic_s", "http_started_utc", "transport_ended_monotonic_s", "transport_ended_utc", "latency_ms", "dispatch_monotonic_s", "started_utc", "deadline_monotonic_s", "deadline_s", "usage_state", "cost_state", "list_price_usd", "reservation_usd", "unknown_exposure_usd"],
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "money": {"type": ["number", "null"], "minimum": 0},
    "clock": {"type": ["number", "null"], "minimum": 0},
    "utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "properties": {
    "schema": {"const": "context-t1-call/v1"},
    "slot": {"enum": ["A1", "A2", "A3", "B1", "B2", "B3"]},
    "run_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "workflow_run_id": {"type": "string"},
    "provider": {"$ref": "#/$defs/nullableString"},
    "model": {"$ref": "#/$defs/nullableString"},
    "route": {"$ref": "#/$defs/nullableString"},
    "auth_mode": {"enum": ["oauth", null]},
    "pricing_sha256": {"$ref": "#/$defs/digest"},
    "output_bound_mode": {"enum": ["request_limit", "documented_max", null]},
    "raw_path": {"$ref": "#/$defs/nullableString"},
    "raw_bytes": {"$ref": "#/$defs/count"},
    "raw_sha256": {"$ref": "#/$defs/digest"},
    "output_bound_tokens": {"type": ["integer", "null"], "minimum": 1},
    "output_bound_evidence_sha256": {"$ref": "#/$defs/digest"},
    "serialized_body_sha256": {"$ref": "#/$defs/digest"},
    "serialized_body_bytes": {"$ref": "#/$defs/count"},
    "input_parts": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false,
        "required": ["kind", "ordinal", "sha256", "bytes"],
        "properties": {"kind": {"enum": ["system", "instructions", "prompt"]},
          "ordinal": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}}}
    },
    "parameters": {"type": "object", "additionalProperties": false, "properties": {
      "max_tokens": {"type": "integer", "minimum": 1},
      "max_output_tokens": {"type": "integer", "minimum": 1},
      "temperature": {"type": "number", "minimum": 0, "maximum": 2},
      "stream": {"const": true},
      "thinking": {"type": "object", "additionalProperties": false,
        "properties": {"type": {"enum": ["adaptive", "enabled", "disabled"]},
          "display": {"const": "summarized"}, "budget_tokens": {"type": "integer", "minimum": 1}}},
      "output_config": {"type": "object", "additionalProperties": false,
        "required": ["effort"], "properties": {"effort": {"enum": ["low", "medium", "high", "max"]}}}
    }},
    "usage": {"type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"],
      "properties": {"input_tokens": {"$ref": "#/$defs/count"}, "output_tokens": {"$ref": "#/$defs/count"},
        "total_tokens": {"$ref": "#/$defs/count"}, "cache_read_input_tokens": {"$ref": "#/$defs/count"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/count"},
        "input_tokens_details": {"type": ["object", "null"], "additionalProperties": false,
          "properties": {"cached_tokens": {"$ref": "#/$defs/count"}}},
        "output_tokens_details": {"type": ["object", "null"], "additionalProperties": false,
          "properties": {"reasoning_tokens": {"$ref": "#/$defs/count"}}}}},
    "stop_reason": {"enum": ["end_turn", "stop_sequence", "stop", "max_tokens", "length", "incomplete", "tool_use", "pause_turn", "refusal", null]},
    "response_id": {"type": ["string", "null"], "pattern": "^(msg|resp)[_-][A-Za-z0-9_-]{1,120}$"},
    "error_class": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "http_started_monotonic_s": {"$ref": "#/$defs/clock"},
    "http_started_utc": {"$ref": "#/$defs/utc"},
    "transport_ended_monotonic_s": {"$ref": "#/$defs/clock"},
    "transport_ended_utc": {"$ref": "#/$defs/utc"},
    "latency_ms": {"$ref": "#/$defs/count"},
    "dispatch_monotonic_s": {"$ref": "#/$defs/clock"},
    "started_utc": {"$ref": "#/$defs/utc"},
    "deadline_monotonic_s": {"$ref": "#/$defs/clock"},
    "deadline_s": {"const": 900},
    "usage_state": {"enum": ["KNOWN", "UNKNOWN"]},
    "cost_state": {"enum": ["KNOWN", "UNKNOWN"]},
    "list_price_usd": {"$ref": "#/$defs/money"},
    "reservation_usd": {"$ref": "#/$defs/money"},
    "unknown_exposure_usd": {"$ref": "#/$defs/money"}
  }
}
