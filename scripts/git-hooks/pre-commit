#!/bin/bash
# Pre-commit hook — runs the same checks as .github/workflows/ci.yml so CI
# failures surface locally before push. Scope matches CI:
#   - ruff check .                (whole project)
#   - mypy temper_ai/             (whole package)
#   - pytest on the test files scripts/select_tests.py picks from
#     scripts/test-selection.toml (-m "not heavy", --timeout=120), through the
#     same machine pool as heavy runs started by hand (docs/testing.md)
#
# Once the host's test-CPU policy is enabled, the whole hook runs inside the
# machine's one shared test-CPU allowance; it enters it before anything else
# (docs/shared-test-cpu-host.md). tests/conftest.py enters `wt slot` before
# starting pytest's workers. Inside a land's check it reuses the land's slot;
# it never waits for its own slot.
#
# There is no bypass. `--no-verify` exists, but a commit that needs it is a
# commit that breaks the build for everyone else; fix the cause instead.
#
# Install: ./scripts/install-git-hooks.sh
# or: git config core.hooksPath scripts/git-hooks

set -euo pipefail

# ─── Shared test CPU, before anything else ────────────────────────────────
# With the host's policy enabled, every phase below runs inside the shared
# test CPU: outside it, the whole hook starts again inside it through Ops'
# test-cpu launcher. Inside it already (a land's checks, an outer entry), or
# with no policy or an inactive one, the hook carries on as always. When the
# placement can't be known or made, it stops with 125 before any phase runs.
# git starts the hook by a relative path (core.hooksPath=scripts/git-hooks); CDPATH= keeps an
# exported CDPATH from sending cd elsewhere or making it print into HOOK.
HOOK="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")"
HOST_ENTRY="$(dirname -- "$HOOK")/../../tests/machine_slot.py"
if ! placement="$(python3 "$HOST_ENTRY" placement)"; then
    echo -e "\033[0;31m✗\033[0m Can't enter the shared test CPU (above). Commit aborted."
    exit 125
fi
if [ "$placement" = outside ]; then
    echo "Entering the shared test CPU..."
    exec python3 "$HOST_ENTRY" enter -- "$BASH" "$HOOK" "$@"
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

PASS="\033[0;32m✓\033[0m"
FAIL="\033[0;31m✗\033[0m"
WARN="\033[0;33m!\033[0m"

# ─── 0. Docs regeneration (existing behavior) ─────────────────────────────
RELEVANT_PATHS=(
    "temper_ai/tools/"
    "temper_ai/llm/providers/"
    "temper_ai/agent/"
    "temper_ai/safety/"
    "temper_ai/stage/topology.py"
    "scripts/generate_docs.py"
)

docs_needed=false
for path in "${RELEVANT_PATHS[@]}"; do
    if git diff --cached --name-only | grep -q "^${path}"; then
        docs_needed=true
        break
    fi
done

if [ "$docs_needed" = true ]; then
    echo "Source files changed — regenerating docs..."
    if ! PYTHONPATH="$REPO_ROOT" python3 "$REPO_ROOT/scripts/generate_docs.py" 2>&1; then
        echo -e "$FAIL Doc generation failed. Commit aborted."
        exit 1
    fi
    git add "$REPO_ROOT/docs/reference/"
    echo -e "$PASS Docs regenerated and staged."
fi

# ─── 1. The locked environment ────────────────────────────────────────────
# Everything below runs through `uv run`, against uv.lock — the same list
# GitHub installs and the same list the live server runs. Before this the
# hook used whatever pytest was on $PATH (sqlmodel 0.0.31 in ~/.local),
# GitHub took the newest of everything (0.0.47) and the server took the lock
# file (0.0.37). Three answers to "do the tests pass", and master stayed red
# for eight days without anyone able to reproduce it.
if ! command -v uv > /dev/null; then
    echo -e "$FAIL uv is not installed, and the hook needs it to use the locked versions."
    echo "   Install: curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
fi

echo "Syncing the locked environment..."
if ! uv sync --frozen --extra dev --quiet; then
    echo -e "$FAIL uv sync --frozen failed. Is uv.lock in step with pyproject.toml?"
    exit 1
fi

# Printed, so the versions used are in the log and any drift is visible
# rather than inferred. --check fails if what got imported is not the lock.
if ! uv run --quiet python scripts/show_versions.py --check; then
    echo -e "$FAIL The environment is not the locked one."
    exit 1
fi

# ─── 2. ruff check . (whole project — matches CI) ─────────────────────────
echo "Running ruff check..."
if ! uv run --quiet ruff check .; then
    echo ""
    echo -e "$FAIL ruff check failed."
    echo "   Try: uv run ruff check --fix ."
    exit 1
fi
echo -e "$PASS ruff check passed."

# ─── 3. mypy temper_ai/ (whole package — matches CI) ──────────────────────
echo "Running mypy on temper_ai/..."
if ! uv run --quiet mypy temper_ai/ --ignore-missing-imports 2>&1; then
    echo ""
    echo -e "$FAIL mypy failed."
    exit 1
fi
echo -e "$PASS mypy passed."

# ─── 4. Which tests this change can affect ────────────────────────────────
# No -x. Stopping at the first failure meant a commit told you about one
# broken test, you fixed it, and the next run told you about the next.
# -n auto lets wt's check_workers default apply. Keep the hook's explicit
# override; otherwise leave the caller's PYTEST_XDIST_AUTO_NUM_WORKERS alone.
if [ -n "${PRECOMMIT_PYTEST_WORKERS:-}" ]; then
    export PYTEST_XDIST_AUTO_NUM_WORKERS="$PRECOMMIT_PYTEST_WORKERS"
fi

# scripts/select_tests.py reads the staged diff during `git commit` and the
# branch diff against master when `wt land` re-runs the hook after a rebase,
# from the same scripts/test-selection.toml rules GitHub CI uses. Heavy
# mutation sweeps (-m heavy) run in nightly.yml on master. If the selector
# fails, fall back to the full suite and the dashboard checks.
run_python="all"
pytest_targets=("tests/")
run_frontend=false
if [ -f "$REPO_ROOT/scripts/select_tests.py" ]; then
    if selection="$(python3 "$REPO_ROOT/scripts/select_tests.py" --explain)"; then
        run_python="none"
        pytest_targets=()
        while IFS= read -r line; do
            case "$line" in
                "python all")
                    run_python="all"
                    pytest_targets=("tests/")
                    ;;
                "python none")
                    run_python="none"
                    pytest_targets=()
                    ;;
                "python "*)
                    run_python="some"
                    read -r -a pytest_targets <<< "${line#python }"
                    ;;
                frontend)
                    run_frontend=true
                    ;;
            esac
        done <<< "$selection"
    else
        echo -e "$WARN select_tests.py failed — running the full test suite and dashboard checks."
        run_frontend=true
    fi
fi

# ─── 4a. The database tier ────────────────────────────────────────────────
# When the commit touches anything that stores something, the tests that
# touch the database run against a real Postgres instead of SQLite — in a
# throwaway container on a port of its own, never the live one (which the
# tests refuse to open anyway: tests/pgtier.py). Set PRECOMMIT_PG=0 to skip,
# PRECOMMIT_PG=1 to force.
DB_PATHS='^(temper_ai/(database|checkpoint|observability|runner|memory|triggers)/|temper_ai/integrations/(inbox|notify|slack|telegram)|temper_ai/.*models\.py|temper_ai/shared/clock\.py|tests/(conftest|pgtier)\.py|alembic/)'
wants_pg="${PRECOMMIT_PG:-auto}"
if [ "$run_python" = "none" ]; then
    wants_pg=0
elif [ "$wants_pg" = "auto" ]; then
    changed_paths="$(git diff --cached --name-only --diff-filter=ACM || true)"
    if [ -z "$changed_paths" ]; then
        base_ref="$(git merge-base HEAD refs/heads/master 2>/dev/null || git merge-base HEAD origin/master 2>/dev/null || true)"
        if [ -n "$base_ref" ]; then
            changed_paths="$(git diff --name-only --diff-filter=ACM "$base_ref" HEAD || true)"
        fi
    fi
    if printf '%s\n' "$changed_paths" | grep -qE "$DB_PATHS"; then
        wants_pg=1
    else
        wants_pg=0
    fi
fi

if [ "$wants_pg" = "1" ]; then
    if ! command -v docker > /dev/null; then
        echo -e "$WARN This commit touches stored data, but docker is not here to run the"
        echo "  Postgres tier. GitHub will run it. Continuing on SQLite."
    else
        echo "Starting a throwaway Postgres for the database tier..."
        if TEMPER_TEST_DATABASE_URL="$(scripts/test-postgres.sh url)"; then
            export TEMPER_TEST_DATABASE_URL
            echo -e "$PASS Postgres tier on ${TEMPER_TEST_DATABASE_URL##*@}"
        else
            echo -e "$FAIL Could not start the throwaway Postgres."
            exit 1
        fi
    fi
fi

if [ "$run_python" = "none" ]; then
    echo -e "$PASS No Python tests affected — skipping pytest."
else
    echo "Running pytest (${#pytest_targets[@]} target(s))..."
    # The tests run without the variables git gives a hook to point it at the
    # repository being committed (GIT_DIR, GIT_INDEX_FILE, ...: the list is
    # `git rev-parse --local-env-vars`). A test that makes a throwaway repo in a temp
    # dir would run its git commands with them. From the main checkout GIT_DIR is the
    # relative `.git`, which happens to resolve inside the temp dir; from a linked
    # worktree it is an absolute path, so the test's `git init`, `git config` and
    # `git commit` land in this repository: core.bare set, the branch being committed
    # moved to the test's commits.
    # Keep wt's stderr live while retaining the tail of pytest's stdout.
    # shellcheck disable=SC2046  (word splitting is intentional)
    if ! (unset $(git rev-parse --local-env-vars); uv run --quiet pytest "${pytest_targets[@]}" -m "not heavy" --timeout=120 -q --no-header -n auto) | tail -40; then
        echo ""
        echo -e "$FAIL pytest failed."
        exit 1
    fi
    echo -e "$PASS pytest passed."
fi

# ─── 5. The dashboard ─────────────────────────────────────────────────────
# Its type check and unit tests, when the commit touches it. They ran only
# on GitHub, so a type error or a broken component test was found after the
# push rather than before it.
STAGED_FE=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/*' || true)
if [ "$run_frontend" = true ] || [ -n "$STAGED_FE" ]; then
    if [ ! -d frontend/node_modules ]; then
        echo -e "$WARN frontend/ changed but node_modules is missing — run 'npm ci' in frontend/."
        echo "  Skipping the dashboard checks; GitHub will still run them."
    else
        echo "Running the dashboard type check..."
        if ! (cd frontend && npx --no-install tsc -b); then
            echo -e "$FAIL The dashboard does not type-check."
            exit 1
        fi
        echo -e "$PASS tsc passed."

        echo "Running the dashboard unit tests..."
        if ! (cd frontend && npx --no-install vitest run --silent 2>&1 | tail -25); then
            echo -e "$FAIL The dashboard unit tests failed."
            exit 1
        fi
        echo -e "$PASS vitest passed."
    fi
fi

echo -e "$PASS All pre-commit checks passed."
