  "copy": [
   {
    "name": "hero",
    "blocks": [
     "Pottery classes on Harbour Street",
     "Make something you\u2019ll keep.",
     "Small wheel and hand-building classes for complete beginners and returning potters. Six people a class, with clay, glazes and firing included."
    ]
   },
   {
    "name": "classes",
    "blocks": [
     "Three ways in",
     "Every class is taught by a working potter and capped at six people, so there is always a hand free when the clay misbehaves.",
     "Wednesdays, six weeks",
     "Wheel basics",
     "Centre the clay, open it and pull your first cylinders. By week six you will trim and glaze a set of cups.",
     "$240, clay and firing included"
    ]
   },
   {
    "name": "how",
    "blocks": [
     "How a class runs",
     "Two hours, one skill at a time. You leave with clay under your nails and a piece on the drying shelf.",
     "1",
     "Arrive and settle in",
     "Aprons, tools and tea are ready. Six people a class means there is room to ask anything.",
     "2",
     "Watch, then try",
     "A short demonstration, then your hands in the clay with a teacher beside you.",
     "3",
     "Shape now, trim later",
     "Pieces dry for a week before trimming. Nothing is wasted: spare clay is recycled.",
     "4",
     "Glaze and collect",
     "Choose from twelve house glazes. We fire everything and send a message when it is ready."
    ]
   },
   {
    "name": "open-studio",
    "blocks": [
     "Keep going after your course",
     "Open studio gives members wheel time four evenings a week, a shelf of their own and firing included."
    ]
   },
   {
    "name": "prices",
    "blocks": [
     "Prices",
     "Clay, glazes and firing are included in every price. Gift vouchers cover any class.",
     "Taster evening Two hours, one fired piece $45",
     "Open studio Monthly membership, four evenings a week $95",
     "Hand-building Four Saturday sessions $160",
     "Private session Two hours for one or two people $120",
     "Wheel basics Six Wednesday sessions $240",
     "Gift voucher Any class, valid for a year from $45"
    ]
   },
   {
    "name": "questions",
    "blocks": [
     "Questions",
     "Do I need any experience?",
     "None. Taster evenings and Wheel basics start from zero.",
     "What should I wear?",
     "Clothes you do not mind getting muddy. We lend aprons and towels.",
     "Can I miss a week?",
     "Tell us a day ahead and join the same session of the next course.",
     "Is it suitable for children?",
     "Classes are for ages 16 and up. Family afternoons run in school holidays."
    ]
   }
  ],
